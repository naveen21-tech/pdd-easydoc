# =============================================================================
# FRONTEND / PUBLIC ENVIRONMENT VARIABLES (Safe for client exposure)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# BACKEND-ONLY ENVIRONMENT VARIABLES (Configured on Vercel Serverless / Backend)
# =============================================================================

# Supabase Server Admin Key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Connections (Prisma)
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:6543/postgres?pgboiler=true"
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# Groq Cloud AI Engine (Backend Only - NEVER expose to client)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: Request timeout in milliseconds (default: 15000)
# GROQ_TIMEOUT_MS=15000
