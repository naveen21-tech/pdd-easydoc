# =============================================================================
# FRONTEND / PUBLIC ENVIRONMENT VARIABLES (Safe for client exposure)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# BACKEND-ONLY ENVIRONMENT VARIABLES (Configured on Vercel Serverless / Backend)
# =============================================================================

# Supabase Server Admin Key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Connections (Prisma)
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:6543/postgres?pgboiler=true"
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# Centralized Self-Hosted Ollama Service (Production: https://YOUR-OLLAMA-SERVER)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DOCUMENT=llama3.2
OLLAMA_MODEL_MCQ=qwen2.5
# Optional: Bearer token if Ollama is behind a secured reverse proxy
# OLLAMA_AUTH_TOKEN=your-secret-token-here
# Optional: Request timeout in milliseconds (default: 25000)
# OLLAMA_TIMEOUT_MS=25000
