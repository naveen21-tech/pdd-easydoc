// Prisma Schema for EasyDoc

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum DocStatus {
  DRAFT
  COMPLETE
}

model Profile {
  id            String                 @id @default(uuid()) // matches Supabase auth.users.id
  name          String
  email         String                 @unique
  role          Role                   @default(USER)
  avatarUrl     String?
  plan          String                 @default("Free")
  createdAt     DateTime               @default(now())
  documents     Document[]
  projects      Project[]
  presentations Presentation[]
  vivaSessions  VivaSession[]
  careerProfiles CareerProfile[]
  aiRequests    AIRequest[]
  notifications Notification[]
  createdGroups  Group[]         @relation("GroupCreator")
  groupMemberships GroupMember[]
  groupDocuments GroupDocument[]
  knowledgeMaterials GroupKnowledgeMaterial[]
  createdAssignments GroupAssignment[]
  assignmentSubmissions GroupAssignmentSubmission[]
  createdMcqTests GroupMcqTest[]
  mcqAttempts     GroupMcqAttempt[]
}

model Document {
  id           String                @id @default(uuid())
  userId       String
  user         Profile               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  content      String                // rich text / markdown / HTML
  templateId   String?
  template     Template?             @relation(fields: [templateId], references: [id])
  projectId    String?
  project      Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status       DocStatus             @default(DRAFT)
  verification DocumentVerification?
  healthReport DocumentHealthReport?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model Template {
  id           String     @id @default(uuid())
  name         String
  category     String
  description  String
  previewImage String?
  usageCount   Int        @default(0)
  documents    Document[]
}

model Project {
  id               String      @id @default(uuid())
  userId           String
  user             Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  domain           String
  description      String
  problemStatement String?
  objectives       String?
  targetUsers      String?
  techStack        Json?       // languages, frameworks, database, tools
  modules          Json?       // array of module specs
  documents        Document[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Presentation {
  id          String   @id @default(uuid())
  userId      String
  user        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId  String?
  title       String
  style       String   @default("Academic")
  slides      Json     // Array of slide objects { id, title, subtitle, bullets, layout, notes, icon }
  theme       Json?    // Theme customization
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VivaSession {
  id          String   @id @default(uuid())
  userId      String
  user        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId  String?
  projectId   String?
  title       String
  difficulty  String   @default("Intermediate")
  questions   Json     // Array of questions { id, question, answer, difficulty, category, userScore, userEvaluation }
  totalScore  Int?
  feedback    Json?    // { strongAreas, weakAreas, recommendations, overallComment }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DocumentVerification {
  id               String    @id @default(uuid())
  verificationId   String    @unique // e.g. "EDOC-2026-8F92A71C"
  documentId       String    @unique
  document         Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId           String
  documentTitle    String
  documentType     String
  checksum         String
  isRevoked        Boolean   @default(false)
  issuedAt         DateTime  @default(now())
  revokedAt        DateTime?
  scanCount        Int       @default(0)
}

model DocumentHealthReport {
  id                   String   @id @default(uuid())
  documentId           String   @unique
  document             Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  overallScore         Int      @default(100)
  structureScore       Int      @default(100)
  readabilityScore     Int      @default(100)
  grammarScore         Int      @default(100)
  professionalismScore Int      @default(100)
  completenessScore    Int      @default(100)
  formattingScore      Int      @default(100)
  issues               Json?    // Array of issue items with category, description, and suggested fix
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model CareerProfile {
  id          String   @id @default(uuid())
  userId      String
  user        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole  String?
  resumeData  Json     // Full ATS resume object
  atsScore    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIRequest {
  id             String   @id @default(uuid())
  userId         String
  user           Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt         String
  provider       String   // "openai" | "anthropic" | "gemini" | "groq"
  responseTimeMs Int
  success        Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  type      String   @default("info") // success | error | info
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum GroupRole {
  ADMIN
  MEMBER
}

model Group {
  id                 String                      @id @default(uuid())
  name               String
  description        String?
  joinCode           String                      @unique
  createdBy          String
  creator            Profile                     @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members            GroupMember[]
  documents          GroupDocument[]
  knowledgeMaterials GroupKnowledgeMaterial[]
  assignments        GroupAssignment[]
  submissions        GroupAssignmentSubmission[]
  mcqTests           GroupMcqTest[]
  mcqAttempts        GroupMcqAttempt[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
}

model GroupMember {
  id        String    @id @default(uuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      GroupRole @default(MEMBER)
  joinedAt  DateTime  @default(now())

  @@unique([groupId, userId])
}

model GroupDocument {
  id          String    @id @default(uuid())
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  uploadedBy  String
  uploader    Profile   @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  title       String
  fileName    String
  fileUrl     String?
  content     String?
  fileType    String    @default("document")
  fileSize    Int?
  documentId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model GroupKnowledgeMaterial {
  id          String    @id @default(uuid())
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  uploadedBy  String
  uploader    Profile   @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  title       String
  subject     String    @default("General")
  unit        String    @default("Unit 1")
  topic       String    @default("Overview")
  chapter     String    @default("Chapter 1")
  fileName    String
  fileType    String    @default("pdf")
  fileSize    Int?      @default(0)
  fileUrl     String?
  content     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model GroupAssignment {
  id                String                      @id @default(uuid())
  groupId           String
  group             Group                       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy         String
  creator           Profile                     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  title             String
  description       String?
  dueDate           DateTime?
  totalMarks        Int                         @default(100)
  requiredSections  Json                        @default("[\"Title Page\", \"Introduction\", \"Problem Statement\", \"Objectives\", \"Methodology\", \"Results\", \"Conclusion\", \"References\"]")
  minReferences     Int                         @default(3)
  requiredKeywords  Json                        @default("[]")
  minWordCount      Int                         @default(300)
  autoReviewEnabled Boolean                     @default(true)
  submissions       GroupAssignmentSubmission[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
}

model GroupAssignmentSubmission {
  id            String          @id @default(uuid())
  assignmentId  String
  assignment    GroupAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  groupId       String
  group         Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId        String
  user          Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  fileName      String
  fileUrl       String?
  content       String?
  fileType      String          @default("docx")
  fileSize      Int?            @default(0)
  status        String          @default("SUBMITTED") // "SUBMITTED" | "LATE"
  qualityScore  Int             @default(80)
  reviewResult  Json?           // { sectionChecks, referencesFound, missingSections, summary, feedback }
  submittedAt   DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([assignmentId, userId])
}

model GroupMcqTest {
  id           String             @id @default(uuid())
  groupId      String
  group        Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy    String
  creator      Profile            @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  title        String
  description  String?
  duration     Int                @default(20) // in minutes
  totalMarks   Int                @default(10)
  passingMarks Int                @default(4)
  isAdaptive   Boolean            @default(false)
  startTime    DateTime?
  endTime      DateTime?
  isPublished  Boolean            @default(true)
  questions    GroupMcqQuestion[]
  attempts     GroupMcqAttempt[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model GroupMcqQuestion {
  id            String       @id @default(uuid())
  testId        String
  test          GroupMcqTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String       // "A" | "B" | "C" | "D"
  marks         Int          @default(1)
  orderIndex    Int          @default(0)
  topic         String       @default("General")
  difficulty    String       @default("MEDIUM") // "EASY" | "MEDIUM" | "HARD"
  createdAt     DateTime     @default(now())
}

model GroupMcqAttempt {
  id              String       @id @default(uuid())
  testId          String
  test            GroupMcqTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  groupId         String
  group           Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId          String
  user            Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  score           Int          @default(0)
  totalMarks      Int          @default(0)
  percentage      Float        @default(0.0)
  passed          Boolean      @default(false)
  totalQuestions  Int          @default(0)
  correctCount    Int          @default(0)
  wrongCount      Int          @default(0)
  unansweredCount Int          @default(0)
  topicScores     Json?        @default("{}")
  adaptiveHistory Json?        @default("[]")
  startedAt       DateTime     @default(now())
  submittedAt     DateTime     @default(now())
  status          String       @default("SUBMITTED") // "SUBMITTED" | "AUTO_SUBMITTED"
  answers         Json         // { [questionId]: "A" | "B" | "C" | "D" }
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([testId, userId])
}
